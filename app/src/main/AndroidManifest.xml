        android:supportsRtl="true"
        android:theme="@style/Theme.Soothsayer"
        tools:targetApi="31">

        <activity android:name=".ui.entrance.LoginActivity" android:exported="false" />
        <activity android:name=".ui.entrance.RegisterActivity" android:exported="false" />
        <activity android:name=".ui.HomeActivity" android:exported="false" />
        <activity android:name=".ui.library.LibraryActivity" android:exported="false" />

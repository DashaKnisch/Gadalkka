        <activity android:name=".ui.MatrixActivity" android:exported="false" />
        <activity android:name=".ui.tests.TestActivity" android:exported="false" />
        <activity android:name=".ui.tests.TestRunActivity" android:exported="false" />
        <activity android:name=".ui.BallActivity" android:exported="false" />
        <activity android:name=".ui.CompatibilityActivity" android:exported="false" />
        <activity
            android:name=".ui.entrance.ZastavkaActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    </application>

</manifest>
